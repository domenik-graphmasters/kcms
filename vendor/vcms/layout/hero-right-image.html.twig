<div class="row py-5 my-5">
    <div class="col-xs-12 col-md-6 order-md-1">
        <img src="{{imageUrl}}" class="mb-4 img-fluid center-block" loading="lazy" width="700" height="500">
    </div>
    <div class="col-sx-12 col-md-6 order-md-0">
        <h1 class="mt-4 mb-3 text-start">{{title}}</h1>
        <div class="">
            <p class="lead text-start">{{paragraph}}</p>
            <div class="mb-5">
                {% if secondaryButtonText != null %})
                <a href="{{primaryButtonUrl}}" class="btn btn-primary btn-lg">{{primaryButtonText}}</a>
                <a href="{{secondaryButtonUrl}}" class="btn btn-outline-dark btn-lg mx-3">{{secondaryButtonText}}</a>
                {% else %}
                <a href="{{primaryButtonUrl}}" class="btn btn-primary btn-lg">{{primaryButtonText}}</a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
